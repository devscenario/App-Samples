<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the demo API calls in SampleApplication.onCreate. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cleartext HTTP is allowed to the host machine only (res/xml/network_security_config.xml):
         Dev Scenario's interceptor exports captured traffic over HTTP `localhost:8080` via
         `adb reverse`, and the Backend screen talks to test-backend over HTTP. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SampleApp"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sampleapp" android:host="demo" />
            </intent-filter>
        </activity>
    </application>

</manifest>

