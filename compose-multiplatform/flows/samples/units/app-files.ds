// App files: the app and the flow change the same file, and each sees what the other did. The file is sample-log.txt
// in the app's own storage. Needs a debuggable build on Android. On a physical iPhone, .delete() isn't possible.
scrollTo("App files", maxScrolls = 8, duration = 150ms)
tap("App files")
tap("Delete file")
waitFor("No file")
assertThat(file("sample-log.txt").exists() == false)
// What the app writes, the flow reads.
tap("Add line")
waitFor("Line 1")
assertThat(file("sample-log.txt").exists())
assertThat(read("sample-log.txt").lastLine() == "Line 1")
tap("Add line")
waitFor(contains("Line 2"))
assertThat(read("sample-log.txt").lastLine().contains("2"))
assertThat(read(regex("sample-.*\\.txt")).firstLine() == "Line 1")
// What the flow writes, the app reads.
file("sample-log.txt").append("From the flow")
tap("Read file")
waitFor(contains("From the flow"))
file("sample-log.txt").write("Replaced")
tap("Read file")
waitFor("Replaced")
tap("Add line")
waitFor(contains("Line 2"))
assertThat(read("sample-log.txt").equals("Replaced\nLine 2\n"))
file("sample-log.txt").clear()
tap("Read file")
waitFor("Empty file")
file("sample-log.txt").delete()
tap("Read file")
waitFor("No file")
// A new file in a new folder.
file("notes/test.txt").createIfNotExists()
assertThat(read("notes/test.txt") == "")
file("notes/test.txt").delete()
// Back to the start screen for the next unit.
tap("Back")
waitFor("Sample Screens")
