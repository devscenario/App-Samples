// Runs an action the sample app registered that returns a value (SampleAppActions, debug builds with
// the SDK built from source): `sampleUser` hands the flow `SAMPLE_USER`, which a later step types.
// In-app SDK driver only; every other driver fails the step.
launchApp(androidAppId = "ge.devtool.samples")
appAction("sampleUser", timeout = 10s, args = args(suffix = ".lovelace"))
tap("Login", timeout = 15s)
tap("Email")
type("${SAMPLE_USER}")
assertVisible("Login email typed: ada.lovelace")
// Back to the start screen.
tap("Back")
waitFor("Sample Screens")
