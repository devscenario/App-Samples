// Android debug build only: the Network screen's stream demos against the sample's local test server
// (on the device's loopback; release builds have none): a WebSocket echo and a server-sent
// event stream. Fully local, so the texts are
// the same on every run. Starts and ends on the home screen ("Sample Screens").
scrollTo("Network", maxScrolls = 6, duration = 150ms)
tap("Network")
waitFor("Dev Scenario interceptor demo", timeout = 10s)
// WebSocket: greeting, two echoes, then the client closes.
tap(id("sample.network.button.websocket"))
waitFor("WS closed: 1000", timeout = 10s)
assertVisible("WS connected")
assertVisible("WS message: welcome")
assertVisible("WS echo: hello")
assertVisible("WS echo: world")
// SSE: three events, then the server ends the stream.
tap(id("sample.network.button.sse"))
waitFor("SSE closed", timeout = 10s)
assertVisible("SSE open")
assertVisible("SSE event 1 (greeting): hello")
assertVisible("SSE event 2 (tick): {\"n\":2}")
assertVisible("SSE event 3 (done): bye")
// Back to the start screen for the next unit.
tap("Back")
waitFor("Sample Screens")
