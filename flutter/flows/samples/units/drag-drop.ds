scrollTo("Drag & Drop", maxScrolls = 6, duration = 150ms)
tap("Drag & Drop")
drag("Alpha", to = "Drop Zone", duration = 40ms)
assertVisible(contains("Alpha dropped in zone"))
drag("Beta", to = "Drop Zone", duration = 40ms)
assertVisible(contains("Beta dropped in zone"))
drag("Gamma", to = "Drop Zone", duration = 40ms)
assertVisible(contains("Gamma dropped in zone"))
drag("Row One", to = "Row Two", duration = 40ms)
assertVisible(contains("moved"))
drag("Row Three", to = "Row Two", duration = 40ms)
assertVisible(contains("moved"))
// Back to the start screen for the next unit.
tap("Back")
waitFor("Sample Screens")
