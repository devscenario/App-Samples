tap("Registration", timeout = 10s)
waitFor("Create account", timeout = 10s)
tap("Full name")
type("Test User")
assertVisible("Registration name typed: Test User")
tap("Email")
type("newuser@test.example.com")
assertVisible("Registration email typed: newuser@test.example.com")
tap("Password")
type("Password123")
assertVisible("Registration password typed: Password123")
assertVisible("Registration success for newuser@test.example.com")
scrollTo("Register", maxScrolls = 2, duration = 150ms)
tap("Register")
// Back to the start screen for the next unit.
tap("Back")
waitFor("Sample Screens")
