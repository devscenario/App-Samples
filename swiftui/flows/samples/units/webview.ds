// WebView: typing, buttons, a checkbox, a link and scrolling inside web content, plus the page →
// native bridge (the native "Last web event" label above the WebView).
scrollTo("WebView", maxScrolls = 8, duration = 150ms)
tap("WebView")
waitFor("Web checkout", timeout = 15s)
assertVisible("Last web event: page loaded")
tap("Email")
type("qa@shop.com")
tap("Promo code")
type("spring10")
tap("Apply code")
assertVisible("Code SPRING10 applied")
assertVisible("Last web event: Code SPRING10 applied")
tap("I agree to the terms")
tap("Pay now")
assertVisible("Payment confirmed for qa@shop.com")
assertVisible("Last web event: payment confirmed")
tap("Terms")
waitFor("Terms of service")
assertVisible("Last web event: opened terms")
tap("Back to checkout")
waitFor("Web checkout")
scrollTo("Footer reached", maxScrolls = 10, duration = 150ms)
// Back to the start screen for the next unit.
tap("Back")
waitFor("Sample Screens")
